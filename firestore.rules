
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and create their own user document.
    // Admins can update any user document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام');
    }

    // Allow authenticated users to read and write to other collections
    match /revenue/{docId} {
        allow read, write: if request.auth != null;
    }
     match /expenses/{docId} {
        allow read, write: if request.auth != null;
    }
     match /requests/{docId} {
        allow read, write: if request.auth != null;
    }
  }
}
