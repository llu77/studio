
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own user document, and create it.
    // Admins can read and write any user document.
    match /users/{userId} {
      allow read, update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام');
      allow create: if request.auth != null;
    }

    // Allow logged-in users to read and write to these collections.
    // In production, you should restrict write access further based on roles.
    match /revenue/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }

    match /requests/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /notifications/{docId} {
        allow read, write: if request.auth != null;
    }

    match /finance_archive/{docId} {
        allow read, write: if request.auth != null;
    }

    match /branches/{docId} {
        allow read, write: if request.auth != null;
    }
  }
}
