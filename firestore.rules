
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read their own data and admins can read anyone's data.
    // Users can create their own user document.
    // Users can update their own data. Admins can update anyone's data.
    match /users/{userId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == userId || 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام');
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && 
                   (request.auth.uid == userId || 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام');
      allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام';
    }

    // Authenticated users can read and write to these collections.
    // More specific rules can be added per role.
    match /revenue/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /requests/{docId} {
      allow read, write: if request.auth != null;
    }

    // General fallback for other collections for authenticated users during development.
    // This can be locked down further in production.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
