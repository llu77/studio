rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    // 1. CREATE: Deny client-side creation. Must be done via Cloud Function.
    // 2. READ, UPDATE: Allow users to read/update their own data.
    // 3. DELETE: Deny client-side deletion.
    match /users/{userId} {
      allow create: if false; // Creation is handled by a Cloud Function
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // --- Collections accessible by authenticated users ---
    // Users can read/write to these collections.
    // Further specific role-based logic can be added later if needed.
    match /revenue/{docId} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }
    match /requests/{docId} {
      allow read, write: if request.auth != null;
    }

    // A general catch-all to deny access to any other collections
    match /{path=**}/documents/{document} {
      allow read, write: if false;
    }
  }
}
