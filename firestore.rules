
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Users Collection ---
    // Users can:
    // 1. Create their own user document.
    // 2. Read their own user document.
    // 3. Update their own user document.
    // Admins can read/write any user document.
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام';
      allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'مدير النظام';
    }

    // --- Data Collections (Revenue, Expenses, Requests) ---
    // General access rules based on user roles.
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
        let role = getUserData().role;
        return role == 'مدير النظام' || role == 'شريك';
    }

    function isSupervisor() {
        return getUserData().role == 'مشرف فرع';
    }

    function isEmployee() {
        return getUserData().role == 'موظف';
    }
    
    // Revenue: Supervisors and Managers can create/read. Only managers can delete.
    match /revenue/{docId} {
      allow read, create: if isManager() || isSupervisor();
      allow update, delete: if isManager();
    }
    
    // Expenses: Supervisors and Managers can create/read. Only managers can delete.
    match /expenses/{docId} {
      allow read, create: if isManager() || isSupervisor();
      allow update, delete: if isManager();
    }
    
    // Requests:
    // - Employees can create their own requests.
    // - Employees can read their own requests.
    // - Supervisors can read requests for their branch.
    // - Managers can read all requests.
    // - Supervisors and Managers can update requests (for status changes).
    match /requests/{docId} {
      allow create: if isEmployee();
      allow read: if (isEmployee() && resource.data.employeeId == request.auth.uid) || 
                     (isSupervisor() && resource.data.employeeBranch == getUserData().branch) || 
                     isManager();
      allow update: if isSupervisor() || isManager();
      allow delete: if isManager();
    }
    
  }
}
