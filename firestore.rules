rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // السماح للمستخدمين المسجلين بإنشاء حساباتهم والوصول للبيانات
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // السماح للمستخدمين المسجلين بالوصول الكامل لباقي المجموعات
    match /revenue/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /expenses/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /requests/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /branches/{document=**} {
      allow read, write: if request.auth != null;
    }

    // قاعدة عامة احتياطية
    match /{path=**}/documents/{document} {
        allow read, write: if request.auth != null;
    }
  }
}
