rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // قاعدة محددة لإنشاء المستخدمين وحمايتهم
    match /users/{userId} {
      // أي مستخدم مسجل يمكنه قراءة بيانات أي مستخدم آخر (يمكن تقييدها لاحقاً)
      allow read: if request.auth != null;
      
      // السماح للمستخدم بإنشاء مستند بياناته الخاص فقط
      allow create: if request.auth != null && request.auth.uid == userId;

      // السماح للمستخدم بتحديث بياناته فقط
      allow update: if request.auth != null && request.auth.uid == userId;

      // لا يسمح بالحذف إطلاقاً
      allow delete: if false;
    }

    // قواعد آمنة لباقي المجموعات
    match /{collection}/{docId} {
      // السماح بالوصول فقط للمستخدمين المسجلين
      allow read, write: if request.auth != null;
    }
  }
}
