
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users can only read and update their own document.
    // User documents are created by a Cloud Function, not by the client.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if false; // Creation is handled by the backend.
    }
    
    // Function to check user's role from their document in Firestore.
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Revenue, Expenses, and Requests collections
    match /{collection}/{docId} {
      // Only authenticated users can access these collections
      allow read, write: if request.auth != null;
    }
  }
}
