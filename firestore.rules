rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قاعدة محددة وواضحة لمجموعة المستخدمين
    match /users/{userId} {
      // أي مستخدم مسجل يمكنه قراءة بيانات أي مستخدم آخر (لأغراض عرض الأسماء وغيرها)
      allow read: if request.auth != null;
      // المستخدم يمكنه فقط إنشاء مستنده الخاص
      allow create: if request.auth != null && request.auth.uid == userId;
      // المستخدم يمكنه فقط تحديث مستنده الخاص
      allow update: if request.auth != null && request.auth.uid == userId;
      // لا يمكن حذف المستخدمين من خلال التطبيق
      allow delete: if false;
    }

    // قواعد الوصول لمجموعات البيانات الرئيسية
    // اسمح فقط للمستخدمين المسجلين بالوصول

    match /revenue/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }

    match /requests/{docId} {
      allow read, write: if request.auth != null;
    }

    match /branches/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finances/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finance_archive/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    // هذه القاعدة العامة تم إزالتها لتجنب التعارض
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}