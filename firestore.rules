
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and update their own document.
    // User documents are created by a Cloud Function trigger (onUserCreate).
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      // Disallow client-side creation to enforce Cloud Function-based creation.
      allow create: if request.auth.uid == userId; 
    }

    // A function to check user roles from the users collection.
    function isUserRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isBranchSupervisor(branchName) {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branch == branchName && isUserRole('مشرف فرع');
    }

    // Rules for data collections (revenue, expenses, requests)
    match /{collection}/{docId} {
      // Admins and Partners can read/write everything.
      allow read, write: if isUserRole('مدير النظام') || isUserRole('شريك');

      // Supervisors can read/write data for their own branch.
      allow read, write: if resource.data.branch != null && isBranchSupervisor(resource.data.branch);

      // Employees can only create new requests for themselves.
      allow create: if collection == 'requests' && request.resource.data.employeeId == request.auth.uid;
      
      // Employees can read their own requests.
      allow read: if collection == 'requests' && resource.data.employeeId == request.auth.uid;
    }
  }
}
