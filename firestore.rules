
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can create their own user document, and read/update it.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Admins and Partners can read all data. Supervisors can read data from their own branch.
    function canReadData(branch) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      let userBranch = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branch;
      return request.auth != null &&
             (userRole == 'مدير النظام' || userRole == 'شريك' || (userRole == 'مشرف فرع' && userBranch == branch));
    }

    // Any authenticated user can write data for now. This can be tightened later.
    function canWriteData() {
      return request.auth != null;
    }

    match /revenue/{docId} {
      allow read: if canReadData(resource.data.branch);
      allow write: if canWriteData();
    }

    match /expenses/{docId} {
      allow read: if canReadData(resource.data.branch);
      allow write: if canWriteData();
    }
    
    match /requests/{docId} {
      // Employees can read their own requests. Supervisors/Admins can read branch requests.
      allow read: if (request.auth != null && request.auth.uid == resource.data.employeeId) || canReadData(resource.data.employeeBranch);
      allow write: if canWriteData();
    }
  }
}
