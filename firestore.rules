
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // المستخدمون: يمكن للمستخدم قراءة وإنشاء وتحديث بياناته فقط
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // السماح بإنشاء المستند فقط إذا كان المستخدم ينشئ مستنده الخاص
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // الإيرادات والمصروفات: يمكن للمستخدمين المصادق عليهم القراءة والكتابة
    // يتم تحديد الوصول على مستوى الفرع في استعلامات التطبيق
    match /{collectionId}/{docId} where collectionId in ['revenue', 'expenses'] {
      allow read, write: if request.auth != null;
    }
    
    // الطلبات:
    match /requests/{requestId} {
      // يمكن للموظف إنشاء طلب لنفسه
      allow create: if request.auth != null && request.auth.uid == request.resource.data.employeeId;
      // يمكن للموظف قراءة طلباته فقط
      allow read: if request.auth != null && request.auth.uid == resource.data.employeeId;
      // يمكن للمدراء والمشرفين تحديث وقراءة جميع الطلبات
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['مدير النظام', 'مشرف فرع'];
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['مدير النظام', 'مشرف فرع'];
    }
  }
}
