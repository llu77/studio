
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Users Collection ---
    // Users can create their own document
    // Users can only read/update their own document
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false; // Deleting users should be handled by an admin function
    }

    // --- Data Collections (Revenue, Expenses, Requests) ---
    // Helper function to check user role from their document
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // Helper function to check user branch
    function getUserBranch(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.branch;
    }

    // Admins and Partners can read/write everything
    // Supervisors can read/write data for their own branch
    // Employees can create requests for themselves
    match /{collection}/{docId} {
      allow read, write: if 
          getUserRole(request.auth.uid) == 'مدير النظام' || 
          getUserRole(request.auth.uid) == 'شريك';

      allow read, write: if
          getUserRole(request.auth.uid) == 'مشرف فرع' &&
          getUserBranch(request.auth.uid) == resource.data.branch;

      // Allow employees to create their own requests
      allow create: if 
          collection == 'requests' &&
          request.resource.data.employeeId == request.auth.uid;
          
      // Allow employees to read their own requests
      allow read: if
          collection == 'requests' &&
          resource.data.employeeId == request.auth.uid;
    }
  }
}
