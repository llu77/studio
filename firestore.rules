
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only create a user document for themselves.
    // They can only read and update their own document.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }
    
    // For other collections, allow read/write for any authenticated user.
    // This is suitable for development but should be refined for production.
    match /revenue/{docId} {
       allow read, write: if request.auth != null;
    }
     match /expenses/{docId} {
       allow read, write: if request.auth != null;
    }
     match /requests/{docId} {
       allow read, write: if request.auth != null;
    }
  }
}
