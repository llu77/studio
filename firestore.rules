rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and update their own user document.
    // User documents are created by a Cloud Function, not by the client.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if false; // Creation is handled by a Cloud Function.
    }

    // Revenue, Expenses, and Requests can be read by any authenticated user.
    // Write access should be more specific in a production environment.
    // For now, any authenticated user can write for development purposes.
    match /revenue/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }

    match /requests/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
