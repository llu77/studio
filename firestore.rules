
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rule 1: Users Collection
    // - Allow reading own document.
    // - Allow creating own document.
    // - Allow updating own document.
    // - Admin can update any user document.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; // Allow any authenticated user to create their own doc
    }

    // Rule 2: General Access for Authenticated Users
    // Allow any authenticated user to read/write to other collections.
    // This is suitable for development. For production, you'd add
    // role-based or ownership-based checks here.
    match /{collection}/{docId} {
       allow read, write: if request.auth != null && collection != 'users';
    }
  }
}
